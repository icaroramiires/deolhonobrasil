# ==============================================================================
# DE OLHO NO BRASIL — VARIÁVEIS DE AMBIENTE (TEMPLATE SEGURO)
# ==============================================================================
# NUNCA comite o arquivo .env real no Git. Copie este arquivo para .env:
# cp .env.example .env

# 1. Ambiente de Execução (development | test | production)
DONB_ENV=development
DONB_LOG_LEVEL=INFO

# 2. Diretórios do Data Lakehouse Local / Volume Docker
DONB_DATA_DIR=./data
DONB_SQLITE_PATH=./data/curated/donb_lakehouse.sqlite

# 3. Fontes Oficiais Primárias
# Portal da Transparência (CGU) — Solicite gratuitamente em:
# https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Limites oficiais: 400 req/min (06h-23h59) | 700 req/min (00h-05h59)
CGU_API_KEY=

# Endpoints Públicos (Sem necessidade de token)
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_COTAS_ZIP_URL_TEMPLATE=https://www.camara.leg.br/cotas/Ano-{year}.csv.zip
SENADO_CEAPS_CSV_URL_TEMPLATE=https://adm.senado.gov.br/adm-dadosabertos/api/v1/senadores/despesas_ceaps/{year}/csv
PNCP_CONSULTA_BASE_URL=https://pncp.gov.br/api/consulta/v1

# 4. Cloudflare R2 (Object Storage - Opcional em Dev, Usado em Prod)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=deolhonobrasil-lakehouse

# 5. Supabase (PostgreSQL + Auth + RLS - Fases 3 a 6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 6. Controles Financeiros e Quotas de IA (Hard Kill Switch)
MAX_DAILY_LLM_CALLS=200
LAYA_EXECUTION_MODE=local_onnx
